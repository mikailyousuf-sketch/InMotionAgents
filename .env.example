NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# WhatsApp Business Platform
META_APP_ID=
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
NEXT_PUBLIC_META_GRAPH_VERSION=v26.0

# Embedded Signup / WhatsApp Business App coexistence.
# Create the configuration in Meta's Embedded Signup / Facebook Login for Business setup.
NEXT_PUBLIC_META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# Encrypts per-business Meta business tokens captured during Embedded Signup.
# Use a long random secret and keep it stable after production connections exist.
INTEGRATION_CREDENTIALS_KEY=

# Legacy / single-business credentials. Embedded Signup connections use encrypted per-business tokens.
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_DEMO_BUSINESS_SLUG=northstar-dental

# Set true to test outbound WhatsApp calls without Meta credentials
WHATSAPP_MOCK_MODE=true

# Internal production workers / cron
# Use a long random value. Send it only in the x-inmotion-worker-secret header.
INTERNAL_WORKER_SECRET=

# Voice / GPT-Live
OPENAI_WEBHOOK_SECRET=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-6-luna
OPENAI_LIVE_VOICE=marin
VOICE_DEMO_BUSINESS_SLUG=northstar-dental

VOICE_WORKER_URL=
VOICE_WORKER_SECRET=
INMOTION_APP_URL=
# Optional staff SIP destination used for AI-to-human transfer.
VOICE_TRANSFER_SIP_URI=

# Production debugging. Keep false/unset unless actively diagnosing.
ENABLE_DEBUG_ROUTES=false
